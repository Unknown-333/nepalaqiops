# =============================================================================
# NepalAQI-Ops Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- API Keys ---
# OpenAQ v3 API key (free signup at https://explore.openaq.org)
OPENAQ_API_KEY=your_openaq_api_key_here

# AQICN/WAQI API token (free at https://aqicn.org/data-platform/token/)
AQICN_TOKEN=your_aqicn_token_here

# --- Telegram Alerts ---
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ENABLED=true

# --- PostgreSQL ---
POSTGRES_USER=nepalaqiops
POSTGRES_PASSWORD=nepalaqiops_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Airflow ---
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://nepalaqiops:nepalaqiops_secret@postgres:5432/airflow_db
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- MinIO (S3-compatible object store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://nepalaqiops:nepalaqiops_secret@postgres:5432/mlflow_db
MLFLOW_ARTIFACT_ROOT=s3://mlflow-artifacts

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
API_SECRET_KEY=your_api_secret_key_here

# --- Model Ensemble Weights ---
PROPHET_WEIGHT=0.4
LSTM_WEIGHT=0.6

# --- Drift Thresholds ---
PSI_WARNING_THRESHOLD=0.2
PSI_RETRAIN_THRESHOLD=0.25
RMSE_DEGRADATION_THRESHOLD=0.15

# --- Kathmandu Valley Bounding Box ---
KTM_LAT_MIN=27.60
KTM_LAT_MAX=27.80
KTM_LON_MIN=85.20
KTM_LON_MAX=85.45
KTM_CENTER_LAT=27.7172
KTM_CENTER_LON=85.3240
