message {
  required string station_id;
  required timestamp timestamp_utc;
  required int32 hour_of_day;
  required int32 day_of_week;
  required int32 month;
  required boolean is_weekend;
  required double hour_sin;
  required double hour_cos;
  required double month_sin;
  required double month_cos;
  optional double pm25_1h_mean;
  optional double pm25_3h_mean;
  optional double pm25_6h_mean;
  optional double pm25_12h_mean;
  optional double pm25_24h_mean;
  optional double pm25_1h_std;
  optional double pm25_6h_std;
  optional double pm25_24h_std;
  optional double pm25_lag_1h;
  optional double pm25_lag_3h;
  optional double pm25_lag_6h;
  optional double pm25_lag_12h;
  optional double pm25_lag_24h;
  optional double pm25_lag_48h;
  optional double pm25_lag_168h;
  optional double temp_c;
  optional double humidity_pct;
  optional double wind_speed_kmh;
  optional double wind_dir_sin;
  optional double wind_dir_cos;
  optional double precip_mm;
  optional double pressure_hpa;
  optional double precip_6h_cumulative;
  required boolean is_tihar;
  required boolean is_dashain;
  required boolean is_indra_jatra;
  required boolean is_monsoon;
  required boolean is_pre_monsoon;
  required boolean is_brick_kiln_season;
  required boolean is_public_holiday;
  optional int32 aqi_us_category;
  optional double station_distance_to_city_center_km;
  required timestamp computed_at;
}
